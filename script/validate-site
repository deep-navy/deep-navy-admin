#!/usr/bin/env bash
set -euo pipefail

workspace="${TMPDIR:-/tmp}/deep-navy-admin-validation"
development_site="$workspace/development"
production_site="$workspace/production"

rm -rf "$workspace"
mkdir -p "$development_site" "$production_site"

npm run check
ruby test/runtime_config_test.rb

DEEP_NAVY_ENVIRONMENT=development \
ADMIN_URL=https://dev.admin.deep.navy \
ADMIN_API_BASE_URL=https://dev.api.deep.navy \
ADMIN_COGNITO_DOMAIN=https://deep-navy-development.auth.us-west-2.amazoncognito.com \
ADMIN_COGNITO_ISSUER=https://cognito-idp.us-west-2.amazonaws.com/us-west-2_development \
ADMIN_COGNITO_CLIENT_ID=developmentclient123 \
ruby scripts/write_runtime_config.rb "$workspace/development.runtime.yml"

DEEP_NAVY_ENVIRONMENT=production \
ADMIN_URL=https://admin.deep.navy \
ADMIN_API_BASE_URL=https://api.deep.navy \
ADMIN_COGNITO_DOMAIN=https://deep-navy-production.auth.us-west-2.amazoncognito.com \
ADMIN_COGNITO_ISSUER=https://cognito-idp.us-west-2.amazonaws.com/us-west-2_production \
ADMIN_COGNITO_CLIENT_ID=productionclient123 \
ruby scripts/write_runtime_config.rb "$workspace/production.runtime.yml"

JEKYLL_ENV=development bundle exec jekyll build \
  --strict_front_matter \
  --config _config.yml,"$workspace/development.runtime.yml" \
  --destination "$development_site"

JEKYLL_ENV=production bundle exec jekyll build \
  --strict_front_matter \
  --config _config.yml,"$workspace/production.runtime.yml" \
  --destination "$production_site"

ruby test/site_test.rb "$development_site" development https://dev.api.deep.navy
ruby test/site_test.rb "$production_site" production https://api.deep.navy
