{
  "name": "@deep-navy/admin-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build_admin_client.mjs",
    "check:vendor": "node scripts/check_vendored_platform_protos.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "node --test test/callback_scrubber_test.cjs test/admin_api_client_test.cjs test/admin_app_security_test.cjs",
    "check": "npm run check:vendor && npm run typecheck && npm run build && npm test"
  },
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.18.0",
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-web": "2.1.2"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  }
}
